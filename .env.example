# KisanMandi — environment setup (sample only, no real values).
#
# There are TWO places config lives. Never put secrets in app.json or app code.
#
#  A) .env.local  — read ONLY by the Convex CLI (npx convex dev / run / env / logs).
#     `npx convex dev` writes it for you when you pick the project. Copy part A of
#     this file to .env.local if you need to point the CLI at a deployment by hand.
#
#  B) Convex env vars — the backend's secrets. NOT read from any file: set each
#     one on the deployment with
#        npx convex env set NAME "value"          (add --prod for production)
#        npx convex env list                      (check what is set)
#     or in the Convex dashboard → Settings → Environment Variables.
#     The full typed list is in convex/convex.config.ts.
#
#  The app itself reads only its two public URLs from app.json → expo.extra
#  (convexUrl = https://<deployment>.convex.cloud, convexSiteUrl = https://<deployment>.convex.site).

# ════════════════════════ A) .env.local (Convex CLI) ════════════════════════
# This project's dev deployment is chatty-meadowlark-808 (the URLs in app.json).
CONVEX_DEPLOYMENT=dev:your-deployment-name
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ═══════════════════ B) Convex env vars (npx convex env set) ════════════════

# ── Better Auth (required) ──
# 32+ random characters: `openssl rand -base64 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Web origin of the app. Dev: Expo web on http://localhost:8081
SITE_URL=http://localhost:8081

# ── Google sign-in (optional; set both to enable) ──
# Google Cloud Console → Credentials → OAuth client ID → Web application.
# Authorized redirect URI: https://<deployment>.convex.site/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admins (optional) ──
# Comma-separated verified sign-in emails that get admin rights (markets, requests, messages).
ADMIN_EMAILS=you@example.com

# ── Resend email (required: verification + reset codes, price-alert emails) ──
# resend.com → API Keys. Sender must be on a domain verified in Resend
# ("KisanMandi <onboarding@resend.dev>" only delivers to your own Resend account email).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="KisanMandi <alerts@yourdomain.com>"

# ── Groq (optional: chat provider "groq" + Whisper voice input) ──
# console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── AWS Bedrock (optional: AI advice, voice-filled listing, Kisan Dost assistant) ──
# IAM user with bedrock:InvokeModel + bedrock:InvokeModelWithResponseStream ...
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=
# ... or a Bedrock API key instead of the key pair
AWS_BEARER_TOKEN_BEDROCK=
# Model overrides (inference-profile IDs; defaults shown)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
ASSISTANT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
