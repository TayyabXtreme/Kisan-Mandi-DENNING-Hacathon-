{
  "expo": {
    "name": "Kisan Mandi1.0",
    "slug": "hackapptwo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hackapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tayyabxtrem07.hackapp",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FCF2DA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tayyabxtrem07.hackapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EEE4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show the nearest mandi first."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph your produce.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to record audio with video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose photos of your produce.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of your produce."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record your voice to search crops and fill in listings."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "convexUrl": "https://chatty-meadowlark-808.convex.cloud",
      "convexSiteUrl": "https://chatty-meadowlark-808.convex.site",
      "router": {},
      "eas": {
        "projectId": "3fef3bd7-9e75-40f7-aade-79a1e0ccbecd"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F3EEE4",
    "description": "Crop prices, mandi comparison, price alerts and a produce marketplace for Sindh farmers.",
    "owner": "tayyabxtrem07"
  }
}
